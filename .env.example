# Template for the local, untracked ".env" file. It must sit in the same
# directory as the Compose file that is started.
#   Development:  cp .env.example .env            (repository root)
#   Deployment:   cp <source-dir>/.env.example /opt/inverter-monitor/.env
# Replace every placeholder. Never commit ".env" (it is listed in .gitignore).
# See docs/configuration.md and docs/deployment.md for details.

# PostgreSQL container. Required by the root compose.yaml and by the deployment
# Compose file. Applied only when the postgres_data volume is first created.
POSTGRES_DB=inverter
POSTGRES_USER=inverter
POSTGRES_PASSWORD=change-me

# MQTT connection of the backend. Read by the deployment Compose file in
# docs/deployment.md. The root compose.yaml does not use these four variables.
# MQTT_HOST must not be empty. MQTT_USERNAME and MQTT_PASSWORD are empty, which
# is correct for a broker without authentication. If your broker requires
# authentication, fill in both with the real values (a password without a user
# name makes the backend exit).
MQTT_HOST=replace-with-broker-host
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
